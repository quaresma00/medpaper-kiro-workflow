# Local Python environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Logs
*.log

# Papers never live in the engine (1.5.0+). Defensive only: `wf doctor` reports any of these
# as BROKEN, and the selftest proves the driver cannot create them. A paper is versioned in
# its own folder under the papers root, never here.
/papers/
/project/
/.wf/
/temp/
/.review_stash/
*.xlsx
*.docx
*.pdf

# Credentials and local configuration
.env
.env.*
*.pem
*.key

# Credentials. mcp.json holds MCP server config and in practice carries API tokens
# inline, so it is never committed. Keep a redacted mcp.example.json instead.
.kiro/settings/mcp.json
**/mcp.json
!**/mcp.example.json

# Local build output
dist/
*.zip

# Windows and editor metadata
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
