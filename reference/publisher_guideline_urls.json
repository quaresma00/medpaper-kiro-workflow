{
  "schema": 1,
  "note": "Candidate URL patterns of official author instructions, by publisher. Every pattern is a lead to VERIFY AT RUNTIME (one polite GET by `wf journal lookup`, or the user's own browser) - publishers move pages, and a pattern is never a source by itself. Groups come from the journal homepage (OpenAlex / DOAJ / NLM); {name_upper} is the upper-case form of a group.",
  "publishers": [
    {"name": "BioMed Central (Springer Nature)", "verify": "runtime",
     "publisher_regex": "BioMed Central|\\bBMC\\b", "host_regex": "biomedcentral\\.com",
     "homepage_regex": "https?://(?P<slug>[a-z0-9-]+)\\.biomedcentral\\.com",
     "templates": ["https://{slug}.biomedcentral.com/submission-guidelines"]},
    {"name": "Springer Nature (link.springer.com)", "verify": "runtime",
     "publisher_regex": "Springer", "host_regex": "springer\\.com",
     "homepage_regex": "https?://(?:link\\.)?springer\\.com/journal/(?P<id>\\d+)",
     "templates": ["https://link.springer.com/journal/{id}/submission-guidelines"]},
    {"name": "Springer Nature (nature.com)", "verify": "runtime",
     "publisher_regex": "Nature Portfolio|Nature Publishing", "host_regex": "nature\\.com",
     "homepage_regex": "https?://www\\.nature\\.com/(?P<slug>[a-z0-9-]+)",
     "templates": ["https://www.nature.com/{slug}/for-authors"]},
    {"name": "Elsevier", "verify": "runtime",
     "publisher_regex": "Elsevier", "host_regex": "sciencedirect\\.com|elsevier\\.com",
     "homepage_regex": "https?://(?:www\\.sciencedirect\\.com/journal|www\\.journals\\.elsevier\\.com|www\\.elsevier\\.com/journals)/(?P<slug>[a-z0-9-]+)",
     "templates": ["https://www.sciencedirect.com/journal/{slug}/publish/guide-for-authors"]},
    {"name": "Wiley", "verify": "runtime",
     "publisher_regex": "Wiley", "host_regex": "wiley\\.com",
     "homepage_regex": "https?://onlinelibrary\\.wiley\\.com/(?:journal|loi)/(?P<code>[0-9a-z]+)",
     "templates": ["https://onlinelibrary.wiley.com/page/journal/{code}/homepage/forauthors.html"]},
    {"name": "Taylor & Francis", "verify": "runtime",
     "publisher_regex": "Taylor|Francis|Informa", "host_regex": "tandfonline\\.com",
     "homepage_regex": "https?://www\\.tandfonline\\.com/(?:toc|loi|journals)/(?P<code>[a-z0-9]+)",
     "templates": ["https://www.tandfonline.com/action/authorSubmission?show=instructions&journalCode={code}"]},
    {"name": "Frontiers", "verify": "runtime",
     "publisher_regex": "Frontiers", "host_regex": "frontiersin\\.org",
     "homepage_regex": "https?://www\\.frontiersin\\.org/journals/(?P<slug>[a-z0-9-]+)",
     "templates": ["https://www.frontiersin.org/journals/{slug}/for-authors/author-guidelines"]},
    {"name": "MDPI", "verify": "runtime",
     "publisher_regex": "MDPI", "host_regex": "mdpi\\.com",
     "homepage_regex": "https?://www\\.mdpi\\.com/journal/(?P<slug>[a-z0-9-]+)",
     "templates": ["https://www.mdpi.com/journal/{slug}/instructions"]},
    {"name": "Wolters Kluwer / LWW", "verify": "runtime",
     "publisher_regex": "Wolters|Lippincott|\\bLWW\\b", "host_regex": "lww\\.com",
     "homepage_regex": "https?://journals\\.lww\\.com/(?P<slug>[a-z0-9-]+)",
     "templates": ["https://journals.lww.com/{slug}/pages/informationforauthors.aspx"]},
    {"name": "JAMA Network (American Medical Association)", "verify": "runtime",
     "publisher_regex": "American Medical Association|JAMA", "host_regex": "jamanetwork\\.com",
     "homepage_regex": "https?://jamanetwork\\.com/journals/(?P<slug>[a-z0-9-]+)",
