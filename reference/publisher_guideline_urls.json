    {"name": "BMJ", "verify": "runtime",
     "publisher_regex": "\\bBMJ\\b", "host_regex": "bmj\\.com",
     "homepage_regex": "https?://(?P<slug>[a-z0-9-]+)\\.bmj\\.com",
     "templates": ["https://{slug}.bmj.com/pages/authors/"]},
    {"name": "Oxford University Press", "verify": "runtime",
     "publisher_regex": "Oxford University Press", "host_regex": "academic\\.oup\\.com",
     "homepage_regex": "https?://academic\\.oup\\.com/(?P<slug>[a-z0-9-]+)",
     "templates": ["https://academic.oup.com/{slug}/pages/General_Instructions"]},
    {"name": "SAGE", "verify": "runtime",
     "publisher_regex": "SAGE", "host_regex": "sagepub\\.com",
     "homepage_regex": "https?://journals\\.sagepub\\.com/(?:home|toc)/(?P<code>[a-z0-9]+)",
     "templates": ["https://journals.sagepub.com/author-instructions/{code_upper}"]},
    {"name": "Karger", "verify": "runtime",
     "publisher_regex": "Karger", "host_regex": "karger\\.com",
