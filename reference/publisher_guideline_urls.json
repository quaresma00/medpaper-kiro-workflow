    {"name": "Thieme", "verify": "runtime",
     "publisher_regex": "Thieme", "host_regex": "thieme",
     "homepage_regex": "https?://www\\.thieme(?:-connect)?\\.(?:de|com)/(?:products/ejournals/journal/|de/|en/)?(?P<slug>[0-9a-z.-]+)",
     "templates": ["https://www.thieme.de/en/{slug}/authors.htm"]},
    {"name": "Dove Medical Press", "verify": "runtime",
     "publisher_regex": "Dove", "host_regex": "dovepress\\.com",
     "homepage_regex": "https?://www\\.dovepress\\.com/(?P<slug>[a-z0-9-]+?)-journal",
     "templates": ["https://www.dovepress.com/{slug}-journal-author-guidelines"]}
  ]
